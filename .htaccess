Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # LiteSpeed may restore REMOTE_ADDR to the visitor IP. Preserve only
  # server-owned Cloudflare trust signals; request headers are not used here.
  RewriteCond %{ENV:FRONTEND_CDN} ^CF$ [NC]
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]

  # Apache/LiteSpeed keeps the actual TCP peer in CONN_REMOTE_ADDR even after
  # REMOTE_ADDR restoration. Match that unspoofable peer against Cloudflare's
  # published IPv4/IPv6 ranges.
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '173.245.48.0/20'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '103.21.244.0/22'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '103.22.200.0/22'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '103.31.4.0/22'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '141.101.64.0/18'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '108.162.192.0/18'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '190.93.240.0/20'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '188.114.96.0/20'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '197.234.240.0/22'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '198.41.128.0/17'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '162.158.0.0/15'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '104.16.0.0/13'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '104.24.0.0/14'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '172.64.0.0/13'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '131.0.72.0/22'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '2400:cb00::/32'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '2606:4700::/32'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '2803:f800::/32'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '2405:b500::/32'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '2405:8100::/32'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '2a06:98c0::/29'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]
  RewriteCond expr "%{CONN_REMOTE_ADDR} -ipmatch '2c0f:f248::/32'"
  RewriteRule ^ - [E=ZPAY_TRUSTED_CLOUDFLARE:1]

  # zsky24.com is an isolated public Z Sky 24 host sharing this codebase.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?zsky24\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://zsky24.com%{REQUEST_URI} [R=301,L,NE]

  RewriteCond %{HTTP_HOST} ^(?:www\.)?zsky24\.com$ [NC]
  RewriteRule ^(?:\.git|\.env|\.svn|\.hg)(?:/|$) - [F,L]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?zsky24\.com$ [NC]
  RewriteRule ^api/(?!znews(?:/|$)).* - [F,L,NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?zsky24\.com$ [NC]
  RewriteRule ^(?:admin|subadmin|user|wallet|worker|private)(?:/|$) - [F,L,NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?zsky24\.com$ [NC]
  RewriteRule ^deploy_version\.txt$ - [L,NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?zsky24\.com$ [NC]
  RewriteRule ^(?:post|creator)/([A-Za-z0-9_-]+)/?$ /znews/index.html [L]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?zsky24\.com$ [NC]
  RewriteRule ^policy/?$ /znews/index.html [L]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?zsky24\.com$ [NC]
  RewriteRule ^$ /znews/index.html [L]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?zsky24\.com$ [NC]
  RewriteRule ^(?!znews(?:/|$)|api/znews(?:/|$)|assets/brand/(?:zpay-icon|favicon|apple-touch-icon)\.png$|manifest\.webmanifest$|sw\.js$).+ - [F,L,NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?zsky24\.com$ [NC]
  RewriteRule ^manifest\.webmanifest$ /znews/manifest-root.webmanifest [L]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?zsky24\.com$ [NC]
  RewriteRule ^sw\.js$ /znews/sw-root.js [L]

  RewriteCond %{HTTP_HOST} !^(?:www\.)?zsky24\.com$ [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?zpayswift\.com(?::[0-9]+)?$ [NC]
  RewriteRule ^ - [E=ZPAY_MAIN_HOST:1]

  RewriteCond %{HTTP_HOST} !^(?:www\.)?zsky24\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://zpayswift.com%{REQUEST_URI} [R=301,L,NE]

  RewriteRule ^(?:\.git|\.env|\.svn|\.hg)(?:/|$) - [F,L]
  RewriteRule ^api/lib(?:/|$) - [F,L]

  RewriteRule ^(?:zpayswift|zawtopup)/api/?$ /api/ [R=301,L,NE]
  RewriteRule ^(?:zpayswift|zawtopup)/api/(.*)$ /api/$1 [R=301,L,NE]

  RewriteRule ^index/?$ /index.html [L,QSA,NC]

  RewriteRule ^track/([A-Za-z0-9_-]+)/?$ /api/mfs/receipt.php?t=$1 [L,QSA,NC]
  RewriteRule ^track/?$ /track.html [L,QSA,NC]
  RewriteRule ^download-apk/?$ /download.php [L,QSA,NC]
  RewriteRule ^api-docs/?$ /api/endpoints.php [L,QSA,NC]
  RewriteRule ^apply-subadmin/?$ /apply-subadmin.html [L,QSA,NC]
  RewriteRule ^privacy/?$ /privacy.html [L,QSA,NC]
  RewriteRule ^terms/?$ /terms.html [L,QSA,NC]

  RewriteRule ^user/?$ /api/user/index.php [L,QSA]
  RewriteRule ^user/dashboard/?$ /api/user/dashboard.php [L,QSA,NC]
  RewriteRule ^user/znews/?$ /api/user/znews.php [L,QSA,NC]
  RewriteRule ^user/add-money/?$ /api/user/add-money.php [L,QSA,NC]
  RewriteRule ^user/transfer/?$ /api/user/transfer.php [L,QSA,NC]
  RewriteRule ^user/topup/?$ /api/user/topup.php [L,QSA,NC]
  RewriteRule ^user/bundle/?$ /api/user/bundle.php [L,QSA,NC]
  RewriteRule ^user/bkash/?$ /api/user/bkash.php [L,QSA,NC]
  RewriteRule ^user/nagad/?$ /api/user/nagad.php [L,QSA,NC]
  RewriteRule ^user/history/?$ /api/user/history.php [L,QSA,NC]
  RewriteRule ^user/services/?$ /api/user/services.php [L,QSA,NC]
  RewriteRule ^user/information/?$ /api/user/information.php [L,QSA,NC]
  RewriteRule ^user/info/?$ /api/user/information.php [L,QSA,NC]
  RewriteRule ^user/notifications/?$ /api/user/notifications.php [L,QSA,NC]
  RewriteRule ^user/profile/?$ /api/user/profile.php [L,QSA,NC]
  RewriteRule ^user/contact-us/?$ /api/user/contact-us.php [L,QSA,NC]
  RewriteRule ^user/support/?$ /api/user/support.php [L,QSA,NC]
  RewriteRule ^user/register/?$ /api/user/register.php [L,QSA,NC]
  RewriteRule ^user/forgot/?$ /api/user/forgot.php [L,QSA,NC]
  RewriteRule ^user/z-pay-transfer/?$ /api/user/transfer.php [L,QSA,NC]
  RewriteRule ^user/bundles/?$ /api/user/bundle.php [L,QSA,NC]
  RewriteRule ^user/send-money/?$ /api/user/bkash.php [L,QSA,NC]

  RewriteRule ^(admin|subadmin)/?$ /api/$1/dashboard.php [L,QSA]
  RewriteRule ^(user|admin|subadmin)/assets/(.*)$ /api/$1/assets/$2 [L,QSA]
  RewriteRule ^(user|admin|subadmin)/(.*\.php)$ /api/$1/$2 [L,QSA]
  RewriteRule ^user(?:/.*)?$ /api/user/index.php [L,QSA]
  RewriteRule ^admin(?:/.*)?$ /api/admin/dashboard.php [L,QSA]
  RewriteRule ^subadmin(?:/.*)?$ /api/subadmin/dashboard.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  # Main Z-Pay host only. Z Sky 24 keeps its isolated policy in znews/.htaccess.
  Header always set Strict-Transport-Security "max-age=31536000" env=ZPAY_MAIN_HOST
  Header always set X-Content-Type-Options "nosniff" env=ZPAY_MAIN_HOST
  Header always set X-Frame-Options "SAMEORIGIN" env=ZPAY_MAIN_HOST
  Header always set Referrer-Policy "strict-origin-when-cross-origin" env=ZPAY_MAIN_HOST
  Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=(), usb=()" env=ZPAY_MAIN_HOST
  Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'" env=ZPAY_MAIN_HOST

  # PHP/LiteSpeed implementation headers are not part of the public contract.
  Header always unset X-Powered-By
  Header always unset X-Turbo-Charged-By

  <FilesMatch "^(?:receipt|attachment)\.php$">
    Header always set Referrer-Policy "no-referrer"
  </FilesMatch>

  <FilesMatch "^(?:sw|sw-root)\.js$">
    Header always set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>

<FilesMatch "^(error_log|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|pnpm-lock\.yaml|test_bundle_request\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "(^|/)\.(env|git|svn|hg)|\.(log|ini|sql|bak|old|zip|tar|gz|yml|yaml|lock|dist)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
