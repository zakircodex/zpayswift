Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /znews/

  RewriteRule ^post/([A-Za-z0-9_-]+)/?$ index.html [L]
  RewriteRule ^creator/([A-Za-z0-9_-]+)/?$ index.html [L]
  RewriteRule ^policy/?$ index.html [L]
  RewriteRule ^$ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://zpayswift.com; form-action 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://zpayswift.com data: blob:; connect-src 'self' https://zpayswift.com; font-src 'self'"
</IfModule>
